APP_ENV=development
DATABASE_URL=sqlite:///data/quantlite.db
SESSION_HOURS=12
FRONTEND_BASE_URL=http://localhost:8765
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,http://localhost:5500,http://127.0.0.1:5500
# Initial founder bootstrap address; used only when the database has no founder account.
BOOTSTRAP_OWNER_EMAIL=founder@example.org
# Generate with: python -m backend.provision_admin --generate-encryption-key
OWNER_MFA_ENCRYPTION_KEY=
# Optional SMTP configuration enables verification and password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=QuantLite <no-reply@example.org>
SMTP_USERNAME=
SMTP_PASSWORD=
